// Gemstone Marketplace – schema.
// M0: entity baseline. M1: auth, seller onboarding, documents, certificate labs,
// auth tokens, rate limits, audit IP, minor-unit money.
//
// MONEY: every amount is an integer in minor units (paise for INR, cents for USD)
// stored as BigInt, plus an ISO 4217 currency code. No floating point, no
// live conversion in Phase 1. Default currency is INR.
//
// ONLY the lead agent edits this file and the migrations (team rule).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  BUYER
  SELLER
  ADMIN
}

/**
 * Account-level status. Seller approval is tracked on SellerProfile.
 */
enum UserStatus {
  ACTIVE
  SUSPENDED
}

/**
 * Seller lifecycle: PENDING -> APPROVED | REJECTED; APPROVED <-> SUSPENDED.
 */
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  OTHER
}

enum DocumentType {
  ID_PROOF
  BUSINESS_PROOF
  CERTIFICATE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MOBILE_OTP
}

enum Availability {
  AVAILABLE
  RESERVED
  SOLD
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum EnquiryType {
  ENQUIRY
  REQUIREMENT
  OFFER
}

enum EnquiryStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum QuotationStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ValuationStatus {
  SUBMITTED
  ANALYSING
  ESTIMATED
  IN_EXPERT_REVIEW
  COMPLETED
}

enum ArticleType {
  EDUCATION
  RESEARCH
  NEWS
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

// ---------- Users and roles ----------

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String?
  mobile            String?    @unique
  passwordHash      String
  role              Role
  status            UserStatus @default(ACTIVE)
  emailVerifiedAt   DateTime?
  mobileVerifiedAt  DateTime?
  passwordChangedAt DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  buyerProfile       BuyerProfile?
  sellerProfile      SellerProfile?
  authTokens         AuthToken[]
  notifications      Notification[]
  sentMessages       Message[]        @relation("MessageSender")
  auditLogs          AuditLog[]       @relation("AuditActor")
  valuations         Valuation[]
  expertValuations   Valuation[]      @relation("ValuationExpert")
  wishlist           WishlistItem[]
  buyerEnquiries     Enquiry[]        @relation("BuyerEnquiries")
  buyerConversations Conversation[]   @relation("BuyerConversations")
  reviewedDocuments  SellerDocument[] @relation("DocumentReviewer")
  approvedSellers    SellerProfile[]  @relation("SellerApprover")

  @@index([role, status])
}

model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  /// SHA-256 of the raw token or OTP. The raw value is never stored.
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  /// Failed attempts (used for OTP lockout).
  attempts  Int              @default(0)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/**
 * Fixed-window rate limit counters, shared across server instances.
 */
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

model BuyerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  name             String
  country          String?
  interests        String[]
  newsletterTopics String[]
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  businessName    String
  businessType    BusinessType
  gstNumber       String?
  addressLine     String
  city            String
  state           String
  country         String
  pincode         String?
  yearsInBusiness Int?
  specialties     String[]
  description     String?
  logoKey         String?
  bannerKey       String?
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  reviewedAt      DateTime?
  rejectionReason String?
  slug            String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy    User?            @relation("SellerApprover", fields: [approvedById], references: [id])
  documents     SellerDocument[]
  gemstones     Gemstone[]
  enquiries     Enquiry[]
  quotations    Quotation[]
  conversations Conversation[]

  @@index([approvalStatus])
}

model SellerDocument {
  id                  String         @id @default(cuid())
  sellerId            String
  type                DocumentType
  /// Storage key (never a public URL). Served only via admin-authorised routes.
  fileKey             String         @unique
  fileName            String
  mimeType            String
  sizeBytes           Int
  certificateLabId    String?
  certificateLabOther String?
  status              DocumentStatus @default(PENDING)
  reviewNote          String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime       @default(now())

  seller         SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  certificateLab CertificateLab? @relation(fields: [certificateLabId], references: [id])
  reviewedBy     User?           @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@index([sellerId])
}

/**
 * Admin-editable list of certificate labs. Not an enum. "Other" uses certificateLabOther.
 */
model CertificateLab {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  isOther   Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  documents SellerDocument[]
}

// ---------- Catalogue ----------

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  gemstones Gemstone[]
}

model Gemstone {
  id            String        @id @default(cuid())
  sellerId      String
  categoryId    String?
  title         String
  slug          String        @unique
  species       String?
  variety       String?
  caratWeight   Decimal?      @db.Decimal(10, 3)
  colour        String?
  clarity       String?
  cut           String?
  shape         String?
  origin        String?
  treatment     String?
  certificateNo String?
  /// Minor units (paise for INR). See schema header.
  priceMinor    BigInt?
  currency      String        @default("INR")
  availability  Availability  @default(AVAILABLE)
  status        ListingStatus @default(DRAFT)
  featured      Boolean       @default(false)
  specs         Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller        SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id])
  media         GemstoneMedia[]
  wishlistedBy  WishlistItem[]
  enquiries     Enquiry[]
  quotations    Quotation[]
  conversations Conversation[]

  @@index([sellerId])
  @@index([status, availability])
  @@index([species, caratWeight])
}

model GemstoneMedia {
  id         String      @id @default(cuid())
  gemstoneId String
  type       MediaType
  fileKey    String
  sortOrder  Int         @default(0)
  status     MediaStatus @default(PROCESSING)
  createdAt  DateTime    @default(now())

  gemstone Gemstone @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)

  @@index([gemstoneId, sortOrder])
}

model WishlistItem {
  buyerId    String
  gemstoneId String
  createdAt  DateTime @default(now())

  buyer    User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  gemstone Gemstone @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)

  @@id([buyerId, gemstoneId])
}

// ---------- Enquiries, quotations, chat ----------

model Enquiry {
  id         String        @id @default(cuid())
  buyerId    String
  sellerId   String
  gemstoneId String?
  type       EnquiryType
  message    String
  status     EnquiryStatus @default(OPEN)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  buyer        User          @relation("BuyerEnquiries", fields: [buyerId], references: [id], onDelete: Cascade)
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  gemstone     Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: SetNull)
  quotations   Quotation[]
  conversation Conversation?

  @@index([buyerId, createdAt])
  @@index([sellerId, status])
}

model Quotation {
  id          String          @id @default(cuid())
  enquiryId   String
  sellerId    String
  gemstoneId  String?
  /// Minor units. See schema header.
  amountMinor BigInt
  currency    String          @default("INR")
  validUntil  DateTime?
  status      QuotationStatus @default(SENT)
  createdAt   DateTime        @default(now())

  enquiry  Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  gemstone Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: SetNull)
}

model Conversation {
  id            String   @id @default(cuid())
  enquiryId     String?  @unique
  buyerId       String
  sellerId      String
  gemstoneId    String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  enquiry  Enquiry?      @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  buyer    User          @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  gemstone Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([buyerId, sellerId, gemstoneId])
  @@index([sellerId, lastMessageAt])
  @@index([buyerId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  flagged        Boolean  @default(false)
  flagReason     String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([flagged])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ---------- Valuation ----------

model Valuation {
  id                String          @id @default(cuid())
  userId            String?
  status            ValuationStatus @default(SUBMITTED)
  inputs            Json
  mediaKeys         String[]
  /// Minor units. See schema header.
  estimateLowMinor  BigInt?
  estimateHighMinor BigInt?
  currency          String?
  confidence        Decimal?        @db.Decimal(4, 3)
  reportKey         String?
  expertId          String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  expert User? @relation("ValuationExpert", fields: [expertId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ---------- Content and newsletter ----------

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  type        ArticleType
  body        String
  status      ContentStatus @default(DRAFT)
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type, status, publishedAt])
}

model HomepageBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  content   Json
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  topics         String[]
  verifiedAt     DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model NewsletterCampaign {
  id           String         @id @default(cuid())
  subject      String
  body         String
  topics       String[]
  status       CampaignStatus @default(DRAFT)
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
}

// ---------- Operations ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
