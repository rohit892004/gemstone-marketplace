// Gemstone Marketplace – schema.
// M0: entity baseline. M3: communication (enquiries, offers, requirements, quotations, chat, moderation). M1: auth, seller onboarding, documents, certificate labs,
// auth tokens, rate limits, audit IP, minor-unit money.
//
// MONEY: every amount is an integer in minor units (paise for INR, cents for USD)
// stored as BigInt, plus an ISO 4217 currency code. No floating point, no
// live conversion in Phase 1. Default currency is INR.
//
// ONLY the lead agent edits this file and the migrations (team rule).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  BUYER
  SELLER
  ADMIN
  /// Expert reviewer for valuations. Created by an admin only. No public signup.
  VALUATOR
}

/**
 * Account-level status. Seller approval is tracked on SellerProfile.
 */
enum UserStatus {
  ACTIVE
  SUSPENDED
}

/**
 * Seller lifecycle: PENDING -> APPROVED | REJECTED; APPROVED <-> SUSPENDED.
 */
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessType {
  SOLE_PROPRIETORSHIP
  PARTNERSHIP
  LLP
  PRIVATE_LIMITED
  PUBLIC_LIMITED
  OTHER
}

enum DocumentType {
  ID_PROOF
  BUSINESS_PROOF
  CERTIFICATE
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  MOBILE_OTP
}

enum Availability {
  AVAILABLE
  RESERVED
  SOLD
  /// Seller-hidden: never shown publicly, even when PUBLISHED.
  HIDDEN
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum ArticleType {
  EDUCATION
  RESEARCH
  NEWS
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

// ---------- Users and roles ----------

model User {
  id                       String     @id @default(cuid())
  email                    String     @unique
  name                     String?
  mobile                   String?    @unique
  passwordHash             String
  role                     Role
  status                   UserStatus @default(ACTIVE)
  emailVerifiedAt          DateTime?
  mobileVerifiedAt         DateTime?
  passwordChangedAt        DateTime?
  lastLoginAt              DateTime?
  /// Contact-detail strikes from moderation. 1 = warning, 2+ = temporary restriction.
  contactStrikes           Int        @default(0)
  messagingRestrictedUntil DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  buyerProfile               BuyerProfile?
  sellerProfile              SellerProfile?
  authTokens                 AuthToken[]
  notifications              Notification[]
  sentMessages               Message[]                 @relation("MessageSender")
  auditLogs                  AuditLog[]                @relation("AuditActor")
  wishlist                   WishlistItem[]
  startedConversations       Conversation[]            @relation("ConversationStarter")
  conversationParticipations ConversationParticipant[]
  offersProposed             Offer[]                   @relation("OfferProposer")
  offersResponded            Offer[]                   @relation("OfferResponder")
  quotationsSent             Quotation[]               @relation("QuotationSeller")
  requirements               Requirement[]             @relation("RequirementBuyer")
  requirementResponses       RequirementResponse[]     @relation("RequirementResponder")
  blocksGiven                UserBlock[]               @relation("BlocksGiven")
  blocksReceived             UserBlock[]               @relation("BlocksReceived")
  reportsFiled               Report[]                  @relation("ReportsFiled")
  reportsResolved            Report[]                  @relation("ReportResolver")
  flagsAsSender              ModerationFlag[]          @relation("FlagSender")
  valuationsRequested        Valuation[]               @relation("ValuationRequester")
  valuationsAssigned         Valuation[]               @relation("ValuationAssignee")
  valuationNotes             ValuationNote[]
  followsGiven               Follow[]                  @relation("Follower")
  referralsReceived          Referral[]                @relation("ReferredUser")
  flagsResolved              ModerationFlag[]          @relation("FlagResolver")
  notificationPreference     NotificationPreference?
  reviewedDocuments          SellerDocument[]          @relation("DocumentReviewer")
  approvedSellers            SellerProfile[]           @relation("SellerApprover")
  reviewsAuthored            Review[]                  @relation("ReviewAuthor")
  reviewsModerated           Review[]                  @relation("ReviewModerator")
  listingsReviewed           Gemstone[]                @relation("ListingReviewer")
  listingDocsVerified        ListingDocument[]         @relation("ListingDocumentVerifier")

  @@index([role, status])
}

model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  purpose   AuthTokenPurpose
  /// SHA-256 of the raw token or OTP. The raw value is never stored.
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  /// Failed attempts (used for OTP lockout).
  attempts  Int              @default(0)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/**
 * Fixed-window rate limit counters, shared across server instances.
 */
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
  updatedAt   DateTime @updatedAt
}

model BuyerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  name             String
  country          String?
  interests        String[]
  newsletterTopics String[]
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id              String            @id @default(cuid())
  userId          String            @unique
  businessName    String
  businessType    BusinessType
  gstNumber       String?
  addressLine     String
  city            String
  state           String
  country         String
  pincode         String?
  yearsInBusiness Int?
  specialties     String[]
  description     String?
  logoKey         String?
  bannerKey       String?
  approvalStatus  ApprovalStatus    @default(PENDING)
  /// Public referral code shown on the membership page. Generated on first use. Null until then.
  referralCode    String?           @unique
  followers       Follow[]
  referralsMade   Referral[]        @relation("ReferrerSeller")
  membership      SellerMembership?
  approvedById    String?
  approvedAt      DateTime?
  reviewedAt      DateTime?
  rejectionReason String?
  tagline         String?
  /// Admin-set: shown in the featured sellers carousel.
  featured        Boolean           @default(false)
  /// Set on demo seed data only. Demo sellers are labelled and refused in production.
  isDemo          Boolean           @default(false)
  /// Cached from approved reviews. Null until the first review.
  ratingAverage   Decimal?          @db.Decimal(3, 2)
  reviewCount     Int               @default(0)
  slug            String            @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?            @relation("SellerApprover", fields: [approvedById], references: [id])
  documents  SellerDocument[]
  gemstones  Gemstone[]
  categories Category[]

  reviews Review[]

  @@index([approvalStatus])
  @@index([approvalStatus, featured])
}

model SellerDocument {
  id                  String         @id @default(cuid())
  sellerId            String
  type                DocumentType
  /// Storage key (never a public URL). Served only via admin-authorised routes.
  fileKey             String         @unique
  fileName            String
  mimeType            String
  sizeBytes           Int
  certificateLabId    String?
  certificateLabOther String?
  status              DocumentStatus @default(PENDING)
  reviewNote          String?
  reviewedById        String?
  reviewedAt          DateTime?
  createdAt           DateTime       @default(now())

  seller         SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  certificateLab CertificateLab? @relation(fields: [certificateLabId], references: [id])
  reviewedBy     User?           @relation("DocumentReviewer", fields: [reviewedById], references: [id])

  @@index([sellerId])
}

/**
 * Admin-editable list of certificate labs. Not an enum. "Other" uses certificateLabOther.
 */
model CertificateLab {
  id         String      @id @default(cuid())
  valuations Valuation[]
  code       String      @unique
  name       String
  isOther    Boolean     @default(false)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)
  createdAt  DateTime    @default(now())

  documents        SellerDocument[]
  gemstones        Gemstone[]
  listingDocuments ListingDocument[]
}

// ---------- Catalogue ----------

model Category {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  parentId     String?
  parent       Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children     Category[]      @relation("CategoryTree")
  gemstones    Gemstone[]
  sellers      SellerProfile[]
  requirements Requirement[]
}

/// A listing. Seller-owned; public only when PUBLISHED, availability is not HIDDEN,
/// and the seller is APPROVED (see lib/listings/visibility.ts).
model Gemstone {
  id               String                   @id @default(cuid())
  moderationFlags  ModerationFlag[]
  valuations       Valuation[]
  sellerId         String
  categoryId       String?
  title            String
  slug             String                   @unique
  /// Gemstone type, e.g. "Sapphire". Free text constrained by the app's list.
  species          String?
  variety          String?
  description      String?
  caratWeight      Decimal?                 @db.Decimal(10, 3)
  /// e.g. "7.5 x 5.2 x 3.1 mm"
  dimensions       String?
  colour           String?
  clarity          String?
  cut              String?
  shape            String?
  origin           String?
  treatment        String?
  certificateLabId String?
  certificateNo    String?
  quantity         Int                      @default(1)
  /// Minor units (paise for INR, cents for USD). Null when priceOnRequest is true.
  priceMinor       BigInt?
  priceOnRequest   Boolean                  @default(false)
  currency         String                   @default("INR")
  availability     Availability             @default(AVAILABLE)
  status           ListingStatus            @default(DRAFT)
  featured         Boolean                  @default(false)
  /// Seller-chosen featured slot (membership). Separate from the admin-set `featured` flag.
  sellerFeatured   Boolean                  @default(false)
  /// Set on demo seed data only. Demo rows are labelled in the UI and refused in production.
  isDemo           Boolean                  @default(false)
  submittedAt      DateTime?
  publishedAt      DateTime?
  reviewedAt       DateTime?
  reviewedById     String?
  rejectionReason  String?
  specs            Json?
  /// Full-text search vector. A generated column defined in the migration; Prisma does not write it.
  searchText       Unsupported("tsvector")?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  seller         SellerProfile     @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category       Category?         @relation(fields: [categoryId], references: [id])
  certificateLab CertificateLab?   @relation(fields: [certificateLabId], references: [id])
  reviewedBy     User?             @relation("ListingReviewer", fields: [reviewedById], references: [id])
  media          GemstoneMedia[]
  documents      ListingDocument[]
  wishlistedBy   WishlistItem[]
  quotations     Quotation[]
  conversations  Conversation[]

  @@index([sellerId])
  @@index([status, availability])
  @@index([status, species])
  @@index([status, caratWeight])
  @@index([status, priceMinor])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([featured])
  @@index([searchText], type: Gin)
}

model GemstoneMedia {
  id         String      @id @default(cuid())
  gemstoneId String
  type       MediaType
  /// Original, metadata-stripped object key (private storage).
  fileKey    String      @unique
  /// Public thumbnail key (images only). Served via the media route, never directly from storage.
  thumbKey   String?     @unique
  mimeType   String
  sizeBytes  Int
  width      Int?
  height     Int?
  alt        String?
  sortOrder  Int         @default(0)
  isCover    Boolean     @default(false)
  status     MediaStatus @default(PROCESSING)
  createdAt  DateTime    @default(now())

  gemstone Gemstone @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)

  @@index([gemstoneId, sortOrder])
}

enum ListingDocumentType {
  CERTIFICATE
  VALUATION_REPORT
  LAB_DOCUMENT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// Seller-attached document for a listing. Private by default. Shown publicly only when
/// isPublic is true AND verificationStatus is VERIFIED AND the listing is public.
model ListingDocument {
  id                 String              @id @default(cuid())
  gemstoneId         String
  type               ListingDocumentType
  title              String
  fileKey            String              @unique
  fileName           String
  mimeType           String
  sizeBytes          Int
  certificateLabId   String?
  isPublic           Boolean             @default(false)
  verificationStatus VerificationStatus  @default(PENDING)
  verificationReason String?
  verifiedById       String?
  verifiedAt         DateTime?
  createdAt          DateTime            @default(now())

  gemstone       Gemstone        @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)
  certificateLab CertificateLab? @relation(fields: [certificateLabId], references: [id])
  verifiedBy     User?           @relation("ListingDocumentVerifier", fields: [verifiedById], references: [id])

  @@index([gemstoneId])
  @@index([verificationStatus])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Seller review. Real reviews require a prior enquiry from the buyer (enforced in M3).
/// Demo reviews have no author account and isDemo = true.
model Review {
  id              String       @id @default(cuid())
  sellerId        String
  authorId        String?
  authorName      String
  rating          Int
  title           String?
  body            String
  status          ReviewStatus @default(PENDING)
  isDemo          Boolean      @default(false)
  moderatedById   String?
  moderatedAt     DateTime?
  /// Required by the admin when rejecting a review (shown to admins; the reviewer is told it was not published).
  rejectionReason String?
  createdAt       DateTime     @default(now())

  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  author    User?         @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  moderator User?         @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([sellerId, status])
}

/// Key/value platform settings (e.g. listing.autoPublishApprovedSellers). Absent key = default.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model WishlistItem {
  buyerId    String
  gemstoneId String
  createdAt  DateTime @default(now())

  buyer    User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  gemstone Gemstone @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)

  @@id([buyerId, gemstoneId])
}

// ---------- Enquiries, quotations, chat ----------

enum ConversationKind {
  ENQUIRY // a buyer enquires about a listing (gemstoneId set)
  GENERAL // a user contacts another user, e.g. from a portfolio page
  REQUIREMENT // a seller responds to a buyer requirement (requirementId set)
}

enum MessageKind {
  TEXT
  OFFER
  QUOTATION
  SYSTEM
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  COUNTERED
  WITHDRAWN
}

enum QuotationStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

enum RequirementStatus {
  OPEN
  CLOSED
}

enum ReportReason {
  SPAM
  SCAM
  HARASSMENT
  FAKE_LISTING
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ModerationStatus {
  OPEN
  DISMISSED
  ACTIONED
}

/// One conversation between two users. Access is checked against ConversationParticipant.
model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind
  /// Unique key that stops duplicate conversations: ENQUIRY "enq:<gemstone>:<buyer>",
  /// GENERAL "gen:<sorted user ids>", REQUIREMENT "req:<requirement>:<seller>".
  pairKey       String           @unique
  startedById   String
  gemstoneId    String?
  requirementId String?
  /// Set on demo seed data only. Shown with a Demo label.
  isDemo        Boolean          @default(false)
  lastMessageAt DateTime         @default(now())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  startedBy    User                      @relation("ConversationStarter", fields: [startedById], references: [id], onDelete: Cascade)
  gemstone     Gemstone?                 @relation(fields: [gemstoneId], references: [id], onDelete: SetNull)
  requirement  Requirement?              @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]
  offers       Offer[]
  quotations   Quotation[]
  reports      Report[]
  flags        ModerationFlag[]

  @@index([gemstoneId])
  @@index([requirementId])
  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversationId String
  userId         String
  /// Last time this user opened the thread. Unread count = messages from others after this.
  lastReadAt     DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, createdAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  kind           MessageKind @default(TEXT)
  /// Text AFTER contact-detail masking. Raw contact details are never stored.
  body           String
  /// True when moderation changed or flagged the message.
  flagged        Boolean     @default(false)
  createdAt      DateTime    @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  attachments  MessageAttachment[]
  offer        Offer?
  quotation    Quotation?
  flags        ModerationFlag[]

  @@index([conversationId, createdAt])
  @@index([flagged, createdAt])
}

model MessageAttachment {
  id         String   @id @default(cuid())
  messageId  String
  /// Opaque private storage key. Served only through an authorised route.
  storageKey String   @unique
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// A structured price offer in a listing conversation. Money in minor units.
model Offer {
  id             String      @id @default(cuid())
  conversationId String
  messageId      String      @unique
  proposerId     String
  amountMinor    BigInt
  currency       String      @default("INR")
  note           String?
  status         OfferStatus @default(PENDING)
  /// Set when this offer is a counter to an earlier offer.
  counterOfId    String?     @unique
  respondedById  String?
  respondedAt    DateTime?
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  proposer     User         @relation("OfferProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  responder    User?        @relation("OfferResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  counterOf    Offer?       @relation("OfferCounter", fields: [counterOfId], references: [id], onDelete: SetNull)
  counteredBy  Offer?       @relation("OfferCounter")

  @@index([conversationId, createdAt])
}

/// A seller's quotation inside a conversation: a listing or a custom item. Money in minor units.
model Quotation {
  id             String          @id @default(cuid())
  conversationId String
  messageId      String          @unique
  sellerId       String
  gemstoneId     String?
  itemTitle      String
  quantity       Int             @default(1)
  amountMinor    BigInt
  currency       String          @default("INR")
  validUntil     DateTime?
  terms          String?
  status         QuotationStatus @default(SENT)
  respondedAt    DateTime?
  withdrawnAt    DateTime?
  createdAt      DateTime        @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message      Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  seller       User         @relation("QuotationSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  gemstone     Gemstone?    @relation(fields: [gemstoneId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([sellerId, status])
}

/// A buyer's requirement. Visible to approved sellers in the matching categories only.
model Requirement {
  id                String            @id @default(cuid())
  buyerId           String
  categoryId        String?
  gemstoneType      String
  shape             String?
  caratMin          Decimal?          @db.Decimal(10, 3)
  caratMax          Decimal?          @db.Decimal(10, 3)
  budgetMinMinor    BigInt?
  budgetMaxMinor    BigInt?
  currency          String            @default("INR")
  certificateNeeded Boolean           @default(false)
  originPreference  String?
  quantity          Int               @default(1)
  deadline          DateTime?
  /// Stored after contact-detail masking.
  notes             String?
  status            RequirementStatus @default(OPEN)
  isDemo            Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  buyer     User                  @relation("RequirementBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  category  Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  responses RequirementResponse[]
  threads   Conversation[]
  flags     ModerationFlag[]

  @@index([status, categoryId, createdAt])
  @@index([buyerId, createdAt])
}

model RequirementResponse {
  id             String   @id @default(cuid())
  requirementId  String
  sellerId       String
  conversationId String   @unique
  createdAt      DateTime @default(now())

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  seller      User        @relation("RequirementResponder", fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([requirementId, sellerId])
}

/// One user blocks another. Blocked users cannot start or continue a conversation with the blocker.
model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  conversationId String?
  messageId      String?
  reason         ReportReason
  details        String?
  status         ReportStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime     @default(now())

  reporter     User          @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy   User?         @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
}

/// Created when contact-detail moderation flags text. Holds masked text only.
model ModerationFlag {
  id             String           @id @default(cuid())
  /// Null for requirement notes, which have no conversation.
  conversationId String?
  messageId      String?
  requirementId  String?
  /// The listing a public-text refusal was about. Null for messages and requirement notes.
  gemstoneId     String?
  senderId       String
  /// MESSAGE, OFFER, QUOTATION, REQUIREMENT, PUBLIC_PROFILE or PUBLIC_LISTING.
  source         String
  /// Detected kinds, e.g. PHONE, EMAIL, URL, HANDLE. Never the detected value.
  kinds          String[]
  status         ModerationStatus @default(OPEN)
  resolvedById   String?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requirement  Requirement?  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  gemstone     Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: SetNull)
  message      Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  sender       User          @relation("FlagSender", fields: [senderId], references: [id], onDelete: Cascade)
  resolvedBy   User?         @relation("FlagResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([senderId, createdAt])
  @@index([gemstoneId])
}

model NotificationPreference {
  userId          String   @id
  emailEnabled    Boolean  @default(true)
  enquiries       Boolean  @default(true)
  messages        Boolean  @default(true)
  offersAndQuotes Boolean  @default(true)
  requirements    Boolean  @default(true)
  valuations      Boolean  @default(true)
  membership      Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// In-app notification. The bell and centre read this. Email is sent separately and marked emailedAt.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ---------- Valuation ----------

// ---------- Content and newsletter ----------

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  type        ArticleType
  body        String
  status      ContentStatus @default(DRAFT)
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type, status, publishedAt])
}

model HomepageBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  content   Json
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  topics         String[]
  verifiedAt     DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model NewsletterCampaign {
  id           String         @id @default(cuid())
  subject      String
  body         String
  topics       String[]
  status       CampaignStatus @default(DRAFT)
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
}

// ---------- Operations ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

enum ValuationStatus {
  DRAFT
  SUBMITTED
  AUTO_VALUED
  IN_EXPERT_REVIEW
  NEEDS_INFO
  COMPLETED
  REJECTED
}

/// Where a valuation request came from. A listing request is prefilled from the product page.
enum ValuationSource {
  LISTING
  STANDALONE
}

enum ValuationMediaKind {
  IMAGE
  VIDEO
}

/// Who gave the current result. AUTO is the rule engine; EXPERT is a valuator sign-off.
enum ValuationValuedBy {
  AUTO
  EXPERT
}

/// An indicative valuation request. Private to the requester, assigned valuators and admins.
model Valuation {
  id          String          @id @default(cuid())
  /// Public reference shown on the PDF and the verification page, e.g. GSV-26-K7Q2M9.
  reference   String          @unique
  requesterId String
  source      ValuationSource
  gemstoneId  String?
  status      ValuationStatus @default(DRAFT)
  isDemo      Boolean         @default(false)

  // Stone details, as entered by the requester.
  gemstoneType      String
  categoryId        String?
  shape             String?
  /// Carat in thousandths (2.5 ct = 2500). Integer, so no floating point reaches the price.
  caratMilli        Int?
  dimensions        String?
  colour            String?
  clarity           String?
  /// Overall quality grade: PREMIUM, FINE, STANDARD or COMMERCIAL. Null when the requester does not know.
  qualityGrade      String?
  origin            String?
  treatment         String?
  labId             String?
  certificateNumber String?
  notes             String?
  currency          String  @default("INR")
  requestExpert     Boolean @default(false)

  // Automatic result. Set when the engine runs. Indicative only.
  autoEstimateMinor BigInt?
  autoLowMinor      BigInt?
  autoHighMinor     BigInt?
  autoConfidence    String?
  autoFactors       Json?
  expertReasons     String[]

  // Expert result. Set on valuator sign-off. The final result replaces the automatic one for display.
  valuedBy           ValuationValuedBy?
  finalEstimateMinor BigInt?
  finalLowMinor      BigInt?
  finalHighMinor     BigInt?
  finalConfidence    String?

  assignedValuatorId String?
  rejectionReason    String?
  /// Set when an admin withdraws the report. The verification page then shows "withdrawn".
  withdrawnAt        DateTime?
  withdrawnReason    String?
  /// The seller who owns the listing chose to show this completed report on the listing.
  publishedOnListing Boolean   @default(false)
  submittedAt        DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  requester        User             @relation("ValuationRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignedValuator User?            @relation("ValuationAssignee", fields: [assignedValuatorId], references: [id], onDelete: SetNull)
  gemstone         Gemstone?        @relation(fields: [gemstoneId], references: [id], onDelete: SetNull)
  certificateLab   CertificateLab?  @relation(fields: [labId], references: [id], onDelete: SetNull)
  media            ValuationMedia[]
  notes_           ValuationNote[]

  @@index([requesterId, createdAt])
  @@index([status, createdAt])
  @@index([assignedValuatorId, status])
  @@index([gemstoneId])
}

model ValuationMedia {
  id          String             @id @default(cuid())
  valuationId String
  kind        ValuationMediaKind
  storageKey  String
  mimeType    String
  sizeBytes   Int
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  valuation   Valuation          @relation(fields: [valuationId], references: [id], onDelete: Cascade)

  @@index([valuationId, sortOrder])
}

/// Thread between requester and valuator: requests for more information, answers, and sign-off notes.
model ValuationNote {
  id          String    @id @default(cuid())
  valuationId String
  authorId    String
  /// NOTE, INFO_REQUEST, INFO_RESPONSE, SIGNOFF, ADMIN.
  kind        String
  body        String
  createdAt   DateTime  @default(now())
  valuation   Valuation @relation(fields: [valuationId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([valuationId, createdAt])
}

/// Reference price per carat, by category, quality grade and carat band. Minor units.
model ReferencePrice {
  id                 String   @id @default(cuid())
  gemstoneType       String
  qualityGrade       String
  band               String
  currency           String
  pricePerCaratMinor BigInt
  isDemo             Boolean  @default(false)
  updatedById        String?
  updatedAt          DateTime @updatedAt

  @@unique([gemstoneType, qualityGrade, band, currency])
}

/// Multiplier in basis points (10000 = x1) for origin, treatment or lab. Keys are lower case.
model ValuationMultiplier {
  id     String  @id @default(cuid())
  kind   String
  key    String
  label  String
  bps    Int
  isDemo Boolean @default(false)

  @@unique([kind, key])
}

enum AnalyticsEventKind {
  PROFILE_VIEW
  LISTING_VIEW
  LISTING_IMPRESSION
  WISHLIST_ADD
  ENQUIRY_STARTED
  QUOTATION_SENT
  QUOTATION_ACCEPTED
  VALUATION_REQUESTED
  FOLLOW
  SEARCH
}

/// Raw analytics event. Holds no personal data: the visitor is a hash that changes every day. Kept 90 days, then
/// deleted by the rollup job (npm run analytics:rollup). Dashboards read AnalyticsRollup, not this table.
model AnalyticsEvent {
  id          String             @id @default(cuid())
  kind        AnalyticsEventKind
  occurredAt  DateTime           @default(now())
  /// UTC calendar day of the event.
  day         DateTime           @db.Date
  /// Daily-salted hash of the first-party visitor cookie. Null for server events with no visitor.
  visitorHash String?
  sellerId    String?
  gemstoneId  String?
  categoryId  String?
  /// Search term, trimmed and lower-cased, at most 80 characters. Never linked to a person.
  term        String?
  /// Makes a view count once per visitor, per item, per day. Unique, so a repeat insert is ignored.
  dedupeKey   String?            @unique
  isDemo      Boolean            @default(false)

  @@index([kind, day])
  @@index([sellerId, day])
  @@index([gemstoneId, day])
  @@index([occurredAt])
}

/// Daily aggregates the dashboards read. Seller and listing rows use sellerId and gemstoneId. Platform rows use
/// kind values starting with PLATFORM_ and no seller or listing. The job rewrites a day's rows, so it can re-run.
model AnalyticsRollup {
  id             String   @id @default(cuid())
  /// day|kind|sellerId|gemstoneId, with empty strings for nulls. Unique for upserts.
  key            String   @unique
  day            DateTime @db.Date
  kind           String
  sellerId       String?
  gemstoneId     String?
  count          Int      @default(0)
  uniqueVisitors Int      @default(0)
  isDemo         Boolean  @default(false)

  @@index([sellerId, day])
  @@index([kind, day])
}

/// A buyer or seller following a seller. Followers are notified when the seller publishes a new listing.
model Follow {
  id         String        @id @default(cuid())
  followerId String
  sellerId   String
  createdAt  DateTime      @default(now())
  isDemo     Boolean       @default(false)
  follower   User          @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@unique([followerId, sellerId])
  @@index([sellerId])
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  VOIDED
}

/// A seller who signed up with another seller's referral code. Qualifies when approved and with a published listing.
model Referral {
  id               String         @id @default(cuid())
  referrerSellerId String
  referredUserId   String         @unique
  status           ReferralStatus @default(PENDING)
  /// Set when a fraud rule matches. Flagged referrals wait for an admin, and do not qualify automatically.
  flagged          Boolean        @default(false)
  flagReason       String?
  /// Keyed hashes of the signup IP and device cookie. Raw values are never stored.
  ipHash           String?
  deviceHash       String?
  qualifiedAt      DateTime?
  voidedAt         DateTime?
  voidedReason     String?
  isDemo           Boolean        @default(false)
  createdAt        DateTime       @default(now())
  referrer         SellerProfile  @relation("ReferrerSeller", fields: [referrerSellerId], references: [id], onDelete: Cascade)
  referred         User           @relation("ReferredUser", fields: [referredUserId], references: [id], onDelete: Cascade)

  @@index([referrerSellerId, status])
  @@index([flagged])
  @@index([ipHash])
  @@index([deviceHash])
}

enum MembershipTier {
  FREE
  PREMIUM
  ELITE
}

/// Tier rules. Admin-editable. The defaults are placeholders, labelled "pending client confirmation".
model TierRule {
  tier               MembershipTier @id
  /// Null means unlimited.
  activeListingLimit Int?
  featuredSlots      Int            @default(0)
  analyticsDays      Int
  hasBadge           Boolean        @default(false)
  /// Added to a seller's ranking in the directory and the top-sellers carousel.
  rankingBoost       Int            @default(0)
  unlockReferrals    Int?
  unlockFollowers    Int?
  minResponseRate    Int            @default(0)
  minRating          Decimal?       @db.Decimal(3, 2)
  updatedById        String?
  updatedAt          DateTime       @updatedAt
}

/// A seller's current tier and the metrics it was last evaluated on. Written by the rollup job and by admin overrides.
model SellerMembership {
  sellerId           String          @id
  tier               MembershipTier  @default(FREE)
  tierSince          DateTime        @default(now())
  /// Set when the seller qualifies for a lower tier. The tier drops to graceTier when this passes.
  graceUntil         DateTime?
  graceTier          MembershipTier?
  manualOverride     Boolean         @default(false)
  overrideReason     String?
  overrideById       String?
  qualifiedReferrals Int             @default(0)
  followerCount      Int             @default(0)
  /// Percent of buyer-started conversations the seller replied to, over the last 90 days. Null with no conversations.
  responseRate       Int?
  /// Average of approved, non-demo reviews. Null with none.
  averageRating      Decimal?        @db.Decimal(3, 2)
  evaluatedAt        DateTime?
  isDemo             Boolean         @default(false)
  seller             SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}
