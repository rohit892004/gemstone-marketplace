// Gemstone Marketplace – Phase 1 schema (v1)
// Source of truth for entities: ../../PHASE1_IMPLEMENTATION_PLAN.md section 3

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum Role {
  BUYER
  SELLER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Availability {
  AVAILABLE
  RESERVED
  SOLD
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum MediaStatus {
  PROCESSING
  READY
  FAILED
}

enum EnquiryType {
  ENQUIRY
  REQUIREMENT
  OFFER
}

enum EnquiryStatus {
  OPEN
  RESPONDED
  CLOSED
}

enum QuotationStatus {
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ValuationStatus {
  SUBMITTED
  ANALYSING
  ESTIMATED
  IN_EXPERT_REVIEW
  COMPLETED
}

enum ArticleType {
  EDUCATION
  RESEARCH
  NEWS
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
}

// ---------- Users and roles ----------

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  mobile           String?    @unique
  passwordHash     String
  role             Role
  status           UserStatus @default(PENDING)
  emailVerifiedAt  DateTime?
  mobileVerifiedAt DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  buyerProfile       BuyerProfile?
  sellerProfile      SellerProfile?
  notifications      Notification[]
  sentMessages       Message[]        @relation("MessageSender")
  auditLogs          AuditLog[]       @relation("AuditActor")
  valuations         Valuation[]
  wishlist           WishlistItem[]
  buyerEnquiries     Enquiry[]        @relation("BuyerEnquiries")
  buyerConversations Conversation[]   @relation("BuyerConversations")
  expertValuations   Valuation[]      @relation("ValuationExpert")
  reviewedDocuments  SellerDocument[] @relation("DocumentReviewer")
  approvedSellers    SellerProfile[]  @relation("SellerApprover")

  @@index([role, status])
}

model BuyerProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  name             String
  country          String?
  interests        String[]
  newsletterTopics String[]
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SellerProfile {
  id              String         @id @default(cuid())
  userId          String         @unique
  businessName    String
  registrationNo  String?
  country         String
  address         String?
  description     String?
  logoKey         String?
  bannerKey       String?
  approvalStatus  ApprovalStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  slug            String         @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy    User?            @relation("SellerApprover", fields: [approvedById], references: [id])
  documents     SellerDocument[]
  gemstones     Gemstone[]
  enquiries     Enquiry[]
  quotations    Quotation[]
  conversations Conversation[]

  @@index([approvalStatus])
}

model SellerDocument {
  id           String         @id @default(cuid())
  sellerId     String
  type         String
  fileKey      String
  status       DocumentStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime       @default(now())

  seller     SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  reviewedBy User?         @relation("DocumentReviewer", fields: [reviewedById], references: [id])
}

// ---------- Catalogue ----------

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  gemstones Gemstone[]
}

model Gemstone {
  id            String        @id @default(cuid())
  sellerId      String
  categoryId    String?
  title         String
  slug          String        @unique
  species       String?
  variety       String?
  caratWeight   Decimal?      @db.Decimal(10, 3)
  colour        String?
  clarity       String?
  cut           String?
  shape         String?
  origin        String?
  treatment     String?
  certificateNo String?
  price         Decimal?      @db.Decimal(14, 2)
  currency      String        @default("USD")
  availability  Availability  @default(AVAILABLE)
  status        ListingStatus @default(DRAFT)
  featured      Boolean       @default(false)
  specs         Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seller        SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category      Category?       @relation(fields: [categoryId], references: [id])
  media         GemstoneMedia[]
  wishlistedBy  WishlistItem[]
  enquiries     Enquiry[]
  quotations    Quotation[]
  conversations Conversation[]

  @@index([sellerId])
  @@index([status, availability])
  @@index([species, caratWeight])
}

model GemstoneMedia {
  id         String      @id @default(cuid())
  gemstoneId String
  type       MediaType
  fileKey    String
  sortOrder  Int         @default(0)
  status     MediaStatus @default(PROCESSING)
  createdAt  DateTime    @default(now())

  gemstone Gemstone @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)

  @@index([gemstoneId, sortOrder])
}

model WishlistItem {
  buyerId    String
  gemstoneId String
  createdAt  DateTime @default(now())

  buyer    User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  gemstone Gemstone @relation(fields: [gemstoneId], references: [id], onDelete: Cascade)

  @@id([buyerId, gemstoneId])
}

// ---------- Enquiries, quotations, chat ----------

model Enquiry {
  id         String        @id @default(cuid())
  buyerId    String
  sellerId   String
  gemstoneId String?
  type       EnquiryType
  message    String
  status     EnquiryStatus @default(OPEN)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  buyer        User          @relation("BuyerEnquiries", fields: [buyerId], references: [id], onDelete: Cascade)
  seller       SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  gemstone     Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: SetNull)
  quotations   Quotation[]
  conversation Conversation?

  @@index([buyerId, createdAt])
  @@index([sellerId, status])
}

model Quotation {
  id         String          @id @default(cuid())
  enquiryId  String
  sellerId   String
  gemstoneId String?
  amount     Decimal         @db.Decimal(14, 2)
  currency   String          @default("USD")
  validUntil DateTime?
  status     QuotationStatus @default(SENT)
  createdAt  DateTime        @default(now())

  enquiry  Enquiry       @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  gemstone Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: SetNull)
}

model Conversation {
  id            String   @id @default(cuid())
  enquiryId     String?  @unique
  buyerId       String
  sellerId      String
  gemstoneId    String?
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  enquiry  Enquiry?      @relation(fields: [enquiryId], references: [id], onDelete: SetNull)
  buyer    User          @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  seller   SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  gemstone Gemstone?     @relation(fields: [gemstoneId], references: [id], onDelete: SetNull)
  messages Message[]

  @@unique([buyerId, sellerId, gemstoneId])
  @@index([sellerId, lastMessageAt])
  @@index([buyerId, lastMessageAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  flagged        Boolean  @default(false)
  flagReason     String?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([flagged])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  payload   Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ---------- Valuation ----------

model Valuation {
  id           String          @id @default(cuid())
  userId       String?
  status       ValuationStatus @default(SUBMITTED)
  inputs       Json
  mediaKeys    String[]
  estimateLow  Decimal?        @db.Decimal(14, 2)
  estimateHigh Decimal?        @db.Decimal(14, 2)
  currency     String?
  confidence   Decimal?        @db.Decimal(4, 3)
  reportKey    String?
  expertId     String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  expert User? @relation("ValuationExpert", fields: [expertId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ---------- Content and newsletter ----------

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  type        ArticleType
  body        String
  status      ContentStatus @default(DRAFT)
  authorId    String?
  publishedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([type, status, publishedAt])
}

model HomepageBlock {
  id        String   @id @default(cuid())
  key       String   @unique
  content   Json
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  topics         String[]
  verifiedAt     DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
}

model NewsletterCampaign {
  id           String         @id @default(cuid())
  subject      String
  body         String
  topics       String[]
  status       CampaignStatus @default(DRAFT)
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime       @default(now())
}

// ---------- Operations ----------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
