# Copy to .env and fill in. Never commit real values.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54330/gemstone?schema=public"
NODE_ENV="development"
# Public address. Required when NODE_ENV=production (startup fails without it).
APP_URL="http://localhost:3000"

# Auth.js session signing. Required in production (32+ chars). Generate: openssl rand -base64 32
AUTH_SECRET=""

# Admin account created/updated by `npm run db:seed` (idempotent). Password min 10 chars.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# Providers. "console" logs messages to the server console; not allowed in production.
# "resend" (email) and "msg91" (SMS) send for real and need the keys below. Empty keys are refused at send time.
EMAIL_PROVIDER="console"
SMS_PROVIDER="console"

# Resend (EMAIL_PROVIDER=resend). EMAIL_FROM must be a sender verified in Resend.
RESEND_API_KEY=""
EMAIL_FROM=""

# MSG91 (SMS_PROVIDER=msg91). Sender ID and template (Flow) ID must be DLT-approved.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""
MSG91_TEMPLATE_ID=""

# Demo seed (npm run db:seed:demo) is refused unless this is "true". Never set it on a real host.
ALLOW_DEMO_SEED="false"

# Private file storage (never inside /public). Max upload size in MB.
STORAGE_DIR="./.data/uploads"
UPLOAD_MAX_MB="10"
